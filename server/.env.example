PORT=3000
DATABASE_PATH=./data/hazard-reporter.db
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000

# Visual Intelligence: heuristic (fast, offline) or clip (Xenova CLIP zero-shot)
VISION_BACKEND=heuristic
VISION_CONFIDENCE_THRESHOLD=0.42

# Email (optional — reports still route and store without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hazardreporter.local
EMAIL_ENABLED=false
